DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-backend.example.com
DJANGO_TIME_ZONE=Asia/Karachi
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Set DB_ENGINE=postgres for production PostgreSQL.
DB_ENGINE=postgres
DB_NAME=rota
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=your-postgres-host
DB_PORT=5432

# Gmail SMTP (use a Google App Password, never your normal Gmail password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=your-google-workspace-or-gmail-address
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
DEFAULT_FROM_EMAIL=ROTA Operations <your-google-workspace-or-gmail-address>

# Public frontend URL used in password-reset links and guard invites
FRONTEND_URL=https://your-frontend.example.com
